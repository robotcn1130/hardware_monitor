# ---- 构建产物 ----
# PyInstaller 的输出，不进仓库（仓库只放源码和第三方二进制）
/dist/
/dist2/
/build/
*.spec

# 发布用的压缩包。正式发布走 GitHub Releases（见 .github/workflows/release.yml），
# 那个 zip 由 CI 现场打，不进仓库——41 MB 的二进制每发一版就留一份在 git 历史里太重。
# 官网 web/index.html 的下载按钮指向本地同名文件，那是给自建静态站用的：
#   · 如果用 GitHub Pages 托管官网、并且希望这个 zip 跟着一起上线 → 删掉下面这行
#   · 如果官网只是想放个下载入口 → 把按钮 href 改成 releases/latest 的链接更省事
/web/*.zip

# ---- 本地运行数据 ----
# 用户的个人设置：窗口位置、勾选了哪些指标、告警阈值
config.json
# 运行日志
/logs/
*.log

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# ---- 编辑器 / 系统 ----
.vscode/
.idea/
Thumbs.db
desktop.ini
*.swp

# ---- 开发日志（内部笔记，含本机路径，未包含在开源发布中）----
/工作日志/

# ---- 本地工具数据 ----
.workbuddy/
_backup/
*.bak
